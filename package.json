{
  "name": "@stradox/vue3-useclickoutside",
  "version": "0.0.5",
  "description": "Use a callback to run actions when a user clicks outside an element",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stradox4u/vue3-useclickoutside.git"
  },
  "type": "module",
  "files": ["dist"],
  "main": "./dist/use-click-outside.umd.cjs",
  "module": "./dist/use-click-outside.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/use-click-outside.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/use-click-outside.umd.cjs"
      }
    }
  },
  "scripts": {
    "test": "vitest run --exclude \"tests/browser/**\" && npm run test:package",
    "test:package": "node --test tests/package.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "build": "vite build && tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('dist/types/index.d.ts', 'dist/types/index.d.cts')\"",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "keywords": [
    "click",
    "outside",
    "click outside",
    "vue",
    "vue3"
  ],
  "author": "Umar Adejoh",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "vue": "^3.5.46"
  }
}
